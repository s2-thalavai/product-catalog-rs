meta {
  name: Validation errors
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  { "sku": "x", "name": "", "price": -1, "stock": -5 }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("RFC 9457 problem+json", () => expect(res.getHeader("content-type")).to.contain("application/problem+json"));
  test("errorCode VALIDATION_FAILED", () => expect(res.getBody().errorCode).to.equal("VALIDATION_FAILED"));
  test("status member matches", () => expect(res.getBody().status).to.equal(400));
  test("has traceId", () => expect(res.getBody().traceId).to.be.a("string").and.not.be.empty);
  test("every violation listed", () => expect(res.getBody().errors).to.have.length(4));
  test("name is required", () => expect(res.getBody().errors).to.include("name is required"));
  test("documented problem type", () => expect(res.getBody().type).to.equal("https://catalog.infy.com/problems/validation-failed"));
}
