meta {
  name: Request from other origin gets no CORS headers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/products?size=1
  body: none
  auth: none
}

headers {
  Origin: https://evil.example.com
}

tests {
  test("HTTP 200 (server answers, the browser blocks)", () => expect(res.getStatus()).to.equal(200));
  test("no Access-Control-Allow-Origin", () => expect(res.getHeader("access-control-allow-origin")).to.be.undefined);
}
