meta {
  name: OpenAPI document
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/openapi.json
  body: none
  auth: none
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("OpenAPI 3", () => expect(res.getBody().openapi).to.match(/^3\./));
  test("documents the product paths", () => {
    expect(res.getBody().paths).to.have.property("/api/v1/products");
    expect(res.getBody().paths).to.have.property("/api/v1/products/{id}");
  });
}
